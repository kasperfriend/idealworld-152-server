# Build output.
#
# Everything matched below is generated by ./tools/ci-build.sh (or by a plain
# `make` inside one of the component directories).  This tree used to ship
# ~250 object files and a dozen archives from the original 32 bit build
# machine; they made any 64 bit link impossible, so they are no longer
# tracked.  Run `./tools/ci-build.sh` to rebuild everything from source.

*.o
*.a
*.so
*.so.*
*.lo
*.la
*.gch
.depend

# daemons and tools land in their own source directory
cnet/glinkd/glinkd
cnet/gdeliveryd/gdeliveryd
cnet/gauthd/gauthd
cnet/gfaction/gfactiond
cnet/gamedbd/gamedbd.wdb
cnet/uniquenamed/uniquenamed
cnet/logservice/logservice
cnet/logclient/logclient
cnet/gamed/gamed
cnet/gclient/gclient
cnet/gacd/gacd
cnet/gacdclient/gacdclient
cgame/gs/gs
cgame/gs/libtgs.a
cgame/gs/task/libtask.so

# cmlib self test (make -C cgame/common test)
cgame/common/cmtest
cgame/common/cmtest*.conf

# tools/ci-build.sh staging area and per step logs
/dist/
/.ci-build/

# stray editor / patch noise
*~
*.orig
*.rej
